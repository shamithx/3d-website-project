# Canonical origin used for metadata, Open Graph URLs, sitemap.xml and robots.txt.
# No trailing slash. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional. When set, the footer "Source code on GitHub" item links here.
# Leave empty until the repository is actually published.
NEXT_PUBLIC_REPO_URL=
